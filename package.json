{
  "name": "@rickx/ckeditor5-line-height",
  "type": "module",
  "version": "48.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "LineHeight plugin for CKEditor5",
  "author": "rickx81",
  "license": "MIT",
  "homepage": "https://github.com/rickx81/ckeditor5-line-height",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickx81/ckeditor5-line-height.git"
  },
  "bugs": "https://github.com/rickx81/ckeditor5-line-height/issues",
  "keywords": [
    "ckeditor",
    "ckeditor-line-height",
    "ckeditor5-line-height",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin",
    "ckeditor5-line-height",
    "ckeditor5-package-generator"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./browser/*": null,
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "ckeditor5-metadata.json",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "pnpm run build:types && pnpm run build:npm && pnpm run build:browser",
    "build:npm": "vite build --mode npm",
    "build:browser": "vite build --mode browser",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --browser.headless=false",
    "translations:synchronize": "node ./scripts/synchronize-translations.js",
    "translations:validate": "node ./scripts/synchronize-translations.js --validate-only",
    "prepare": "husky && pnpm run build",
    "postpublish": "pnpm run build"
  },
  "peerDependencies": {
    "@ckeditor/ckeditor5-core": ">=48.0.0 || ^0.0.0-nightly || ^0.0.0-internal",
    "ckeditor5": ">=48.0.0 || ^0.0.0-nightly || ^0.0.0-internal"
  },
  "dependencies": {},
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@ckeditor/ckeditor5-core": "latest",
    "@ckeditor/ckeditor5-dev-build-tools": "59.0.0",
    "@ckeditor/ckeditor5-dev-translations": "59.0.0",
    "@ckeditor/ckeditor5-inspector": "^5.0.3",
    "@ckeditor/ckeditor5-package-tools": "^4.1.1",
    "@types/node": "^24.13.3",
    "@vitest/browser-webdriverio": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "chalk": "^5.6.2",
    "ckeditor5": "latest",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "rimraf": "^6.1.3",
    "typescript": "5.5.4",
    "vite": "^8.2.0",
    "vite-plugin-svgo": "^2.0.0",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.1"
  },
  "overrides": {
    "sugarss": "^5.0.1"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
